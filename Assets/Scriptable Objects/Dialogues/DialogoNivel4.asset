  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 20cfcbdec6ed3dd47a98bff01abd736a, type: 3}
  m_Name: DialogoNivel4
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 85bff3ef2bd51f044bee18b629db83fa, type: 2}
    text: "Ah... una visita. Hace ciclos que nadie ven\xEDa por aqu\xED. Todos prefieren
      la API v2, con su JSON brillante y r\xE1pido."
  - speaker: {fileID: 11400000, guid: 7ea9acbda82268142bb821951f9cf825, type: 2}
    text: "Este lugar se ve... antiguo. \xBFPor qu\xE9 no se actualiz\xF3?"
  - speaker: {fileID: 11400000, guid: 85bff3ef2bd51f044bee18b629db83fa, type: 2}
    text: "Porque muchos sistemas vitales a\xFAn dependen de este c\xF3digo viejo.
      Si lo borramos, el servidor colapsa. As\xED que aqu\xED me quedo, manteniendo
      rutas obsoletas."
  - speaker: {fileID: 11400000, guid: 85bff3ef2bd51f044bee18b629db83fa, type: 2}
    text: "Pero ten cuidado. Los datos aqu\xED son pegajosos. Los Cache Ghosts se
      regeneran infinitamente porque el servidor cree que la informaci\xF3n no ha
      cambiado (HTTP 304). Necesitas forzar una actualizaci\xF3n."
  - speaker: {fileID: 11400000, guid: 7ea9acbda82268142bb821951f9cf825, type: 2}
    text: Ok, creo que seguire con mi camino.
  options: []
