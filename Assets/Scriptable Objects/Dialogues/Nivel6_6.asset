  m_Script: {fileID: 11500000, guid: 20cfcbdec6ed3dd47a98bff01abd736a, type: 3}
  m_Name: Nivel6_6
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 7ea9acbda82268142bb821951f9cf825, type: 2}
    text: "Todo est\xE1... en blanco. Como si fuera c\xF3digo puro."
  - speaker: {fileID: 11400000, guid: 7c42967f6f4351d4f913b6be1cca30e4, type: 2}
    text: "Est\xE1s en el n\xFAcleo. Aqu\xED no hay representaciones visuales, solo
      l\xF3gica pura. Este es el cerebro del servidor."
  - speaker: {fileID: 11400000, guid: 7c42967f6f4351d4f913b6be1cca30e4, type: 2}
    text: "ADMIN_ROOT protege este espacio. Para ella, cualquier entidad no autorizada
      es un virus. Debes construir la\r\npetici\xF3n perfecta para demostrar que
      eres leg\xEDtimo."
  - speaker: {fileID: 11400000, guid: 7c42967f6f4351d4f913b6be1cca30e4, type: 2}
    text: "Terminal central activada. Construye la petici\xF3n perfecta usando todo
      lo que has aprendido: m\xE9todo POST, URL\r\ncompleta, todos los headers necesarios,
      y body JSON v\xE1lido."
  - speaker: {fileID: 11400000, guid: 7c42967f6f4351d4f913b6be1cca30e4, type: 2}
    text: "Revisa tu inventario. Tienes todos los componentes: Bearer Token, JWT
      con userId, API Key Universal, Token\r\nMaestro. Comb\xEDnalos correctamente."
  options: []
