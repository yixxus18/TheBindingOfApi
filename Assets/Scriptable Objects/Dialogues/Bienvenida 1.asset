  m_Script: {fileID: 11500000, guid: 20cfcbdec6ed3dd47a98bff01abd736a, type: 3}
  m_Name: Bienvenida 1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 5441cfc1900a84149b4f19fedd511571, type: 2}
    text: "Shhh... El ruido de los datos corruptos es ensordecedor. Antes, esta biblioteca
      era un \xEDndice perfecto de conocimiento. Ahora, las funciones hu\xE9rfanas
      deambulan por los pasillos atacando a cualquiera."
  - speaker: {fileID: 11400000, guid: 5441cfc1900a84149b4f19fedd511571, type: 2}
    text: "Ten cuidado con lo que ejecutas. Un c\xF3digo mal escrito no solo falla,
      sino que puede cobrar vida. Esos monstruos... sol\xEDan ser funciones de 'Hola
      Mundo' que nadie cerr\xF3 correctamente."
