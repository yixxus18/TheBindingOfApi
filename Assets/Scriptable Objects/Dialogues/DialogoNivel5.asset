  m_Script: {fileID: 11500000, guid: 20cfcbdec6ed3dd47a98bff01abd736a, type: 3}
  m_Name: DialogoNivel5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: adf2412dea3b87e43a149d6f391237bb, type: 2}
    text: "\xA1ESPERA! \xA1NO! \xA1SI! \xA1TAL VEZ! \xBFRecibiste la respuesta? \xA1Yo
      tampoco! \xA1Es el Callback Hell!"
  - speaker: {fileID: 11400000, guid: 7ea9acbda82268142bb821951f9cf825, type: 2}
    text: "\xA1C\xE1lmate! \xBFQu\xE9 est\xE1 pasando aqu\xED?"
  - speaker: {fileID: 11400000, guid: adf2412dea3b87e43a149d6f391237bb, type: 2}
    text: "\xA1Peticiones anidadas! \xA1Una dentro de otra, infinitamente! Estamos
      atrapados en un bucle while(true). El servidor de eco est\xE1 repitiendo todo
      lo que hacemos."
  - speaker: {fileID: 11400000, guid: adf2412dea3b87e43a149d6f391237bb, type: 2}
    text: "\xA1Peticiones anidadas! \xA1Una dentro de otra, infinitamente! Estamos
      atrapados en un bucle while(true). El servidor de eco est\xE1 repitiendo todo
      lo que hacemos."
  - speaker: {fileID: 11400000, guid: adf2412dea3b87e43a149d6f391237bb, type: 2}
    text: "Escucha, la \xFAnica forma de salir es cancelar la suscripci\xF3n. Tienes
      que encontrar el ID del webhook que nos mantiene atrapados y enviar una orden
      de DELETE. \xA1R\xE1pido, antes de que el Timeout nos alcance!"
  options: []
