  m_Name: DialogoNivel6
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 0171b8b691df2fd48a4fde9d56f435a9, type: 2}
    text: "ALERTA DE INTRUSI\xD3N. ENTIDAD NO RECONOCIDA. NIVEL DE AMENAZA: CR\xCDTICO."
  - speaker: {fileID: 11400000, guid: 7ea9acbda82268142bb821951f9cf825, type: 2}
    text: "\xA1No soy un virus! \xA1Vengo a arreglarlo! \xA1Tengo las credenciales!"
  - speaker: {fileID: 11400000, guid: adf2412dea3b87e43a149d6f391237bb, type: 2}
    text: "\xA1Peticiones anidadas! \xA1Una dentro de otra, infinitamente! Estamos
      atrapados en un bucle while(true). El servidor de eco est\xE1 repitiendo todo
      lo que hacemos."
  - speaker: {fileID: 11400000, guid: adf2412dea3b87e43a149d6f391237bb, type: 2}
    text: "INCORRECTO. Un desarrollador leg\xEDtimo sabr\xEDa c\xF3mo ejecutar el
      despliegue perfecto. Prep\xE1rate para la eliminaci\xF3n. Ejecutando rm -rf
      /..."
